{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psrmcp.local/schemas/catalog_search.input.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "ra_deg": {
      "type": "number",
      "minimum": 0,
      "maximum": 360
    },
    "dec_deg": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "radius_deg": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 180
    },
    "p0_min_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "p0_max_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "dm_min": {
      "type": "number",
      "minimum": 0
    },
    "dm_max": {
      "type": "number",
      "minimum": 0
    },
    "pb_min_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "pb_max_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "flux_min_mjy": {
      "type": "number",
      "minimum": 0
    },
    "gb_min": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "gb_max": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "binary_only": {
      "type": "boolean",
      "default": false
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Extra psrcat columns to return in extra_fields: age bsurf edot dist s400 s1400 w50 w10 pb a1 ecc om gl gb"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "default": 50
    },
    "cursor": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
