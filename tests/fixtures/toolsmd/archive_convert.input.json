{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psrmcp.local/schemas/archive_convert.input.json",
  "type": "object",
  "required": [
    "archive",
    "output_format"
  ],
  "properties": {
    "archive": {
      "type": "string",
      "description": "Artifact ID or relative path under a read root"
    },
    "root": {
      "type": "string"
    },
    "output_format": {
      "enum": [
        "psrfits",
        "psrarchive",
        "sigproc",
        "ascii"
      ]
    },
    "output_name": {
      "type": "string",
      "maxLength": 128
    }
  },
  "additionalProperties": false
}
