{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psrmcp.local/schemas/job_cancel.input.json",
  "type": "object",
  "required": [
    "job_id"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "pattern": "^job_[A-Za-z0-9_-]{8,64}$"
    },
    "force": {
      "type": "boolean",
      "default": false,
      "description": "跳过宽限期，直接终止进程组"
    }
  },
  "additionalProperties": false
}
