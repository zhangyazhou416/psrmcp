{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psrmcp.local/schemas/data_find.input.json",
  "type": "object",
  "required": [
    "pattern"
  ],
  "properties": {
    "pattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "glob 模式，例如 '*.ar'、'J0437*'、'**/*.fits'"
    },
    "root": {
      "type": "string",
      "description": "read_roots 下的子目录；省略时搜索所有 root"
    },
    "max_depth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "default": 3
    },
    "max_results": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 100
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\.[A-Za-z0-9]+$"
      },
      "maxItems": 20
    },
    "modified_after": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
