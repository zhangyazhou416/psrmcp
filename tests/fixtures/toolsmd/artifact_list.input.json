{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psrmcp.local/schemas/artifact_list.input.json",
  "type": "object",
  "properties": {
    "kind": {
      "enum": [
        "archive",
        "ephemeris",
        "tim",
        "par",
        "profile",
        "mask",
        "plot",
        "residuals",
        "log",
        "catalog",
        "json",
        "other"
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500,
      "default": 50
    },
    "cursor": {
      "type": "string"
    },
    "created_after": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
