# ---------------------------------------------------------------------------
# versions.env — 脉冲星软件栈的版本 / pin / 下载地址(唯一事实来源)
#
# 被 scripts/install_pulsar_stack.sh source。改 pin 只改这里,不要动安装逻辑。
# 语法约束:必须是 bash 可 source 的纯 KEY="VALUE" 赋值(不要写命令、不要 export)。
#
# 约定:
#   *_URL       主下载/克隆地址
#   *_MIRROR_*  主地址失败后的回退地址(允许为空字符串 = 无回退)
#   *_REF       git pin:可以是具体 commit / tag / 分支
#   PY_*        Python 包版本(不含包名;包名映射见 install_pulsar_stack.sh)
#
# 下面的三个 *_REF 是 2026-10-24 实际装机成功并验证过的 commit
# (整套栈在 Deepin 25 / gcc12 上以此状态编译通过、19 项 CLI 契约探测通过),
# 固定下来以保证可复现;想追新就改回 HEAD 或换 commit。
# ---------------------------------------------------------------------------

# --- tempo2 ---------------------------------------------------------------
# bitbucket.org/psrsoft 已不再是权威仓库,官方镜像在 github ipta 组织
TEMPO2_URL="https://github.com/ipta/tempo2.git"
TEMPO2_MIRROR_URL="https://github.com/mattpitkin/tempo2.git"
TEMPO2_REF="fda6ad4a9753ad7dc5d291406f2f310a9161423f"
# resolved 2026-10-24: 实测成功的 commit(2026-10-12)

# --- psrchive -------------------------------------------------------------
PSRCHIVE_URL="https://gitlab.com/pulsar-astronomy/psrchive.git"
PSRCHIVE_MIRROR_URL="https://github.com/psrchive/psrchive.git"
PSRCHIVE_REF="d4b4e2d9c4bd31a5834f8bc2219bfcb87f70b20e"
# resolved 2026-10-24: 实测成功的 commit(2026-10-19;含 2026-05 的 Convention::* 改名)

# --- dspsr ----------------------------------------------------------------
# 实测权威仓库在 SourceForge(gitlab.com/pulsar-astronomy/dspsr 非官方同步)
DSPSR_URL="https://git.code.sf.net/p/dspsr/code"
DSPSR_MIRROR_URL="https://gitlab.com/pulsar-astronomy/dspsr.git"
DSPSR_REF="3f3d5b437f4840ab8a6a656002dca2cb5f3aa680"
# resolved 2026-10-24: 实测成功的 commit(2026-05-27;需配 psrchive API 兼容补丁)

# --- tempo(经典 tempo,可选阶段)------------------------------------------
TEMPO_URL="https://git.code.sf.net/p/tempo/tempo"
TEMPO_REF="HEAD"

# --- PRESTO(仅 --with-presto 时安装)--------------------------------------
PRESTO_URL="https://github.com/scottransom/presto.git"
PRESTO_TAG="v5.2.0"

# --- psrcat(ATNF 星表包)--------------------------------------------------
# 注意:ATNF 的自动下载地址已失效(2026-10 实测 404),脚本不再尝试联网下载;
# 请从 ATNF 网页手动下载 psrcat_pkg tarball(实测可用版本 v2.6.1),安装器会按
# --psrcat-tarball → $SRC_DIR → ~/Downloads → cwd 的顺序查找。编译命令为
# `gcc -fcommon -o psrcat *.c -lm`(新版 gcc 必须 -fcommon),无需 tcsh。
PSRCAT_VERSION="2.6.1"

# --- 构建依赖(psrchive/dspsr 的硬依赖,源码自建进前缀)--------------------
# 系统 apt 的 libfftw3-dev 只有双精度、libcfitsio-dev 非重入,不满足需求
FFTW_VERSION="3.2.2"
FFTW_URL="http://www.fftw.org/fftw-3.2.2.tar.gz"
CFITSIO_VERSION="3.49"
CFITSIO_URL="https://heasarc.gsfc.nasa.gov/FTP/software/fitsio/c/cfitsio-3.49.tar.gz"

# --- PGPLOT(可选阶段)----------------------------------------------------
# Caltech ftp 已死;ASTRON GitLab 镜像实测可用。补丁取自 psrchive 源码树 packages/
PGPLOT_VERSION="5.2"
PGPLOT_URL="https://git.astron.nl/giga/psrmod_snellius/-/raw/main/sources_tar/pgplot5.2.tar.gz"

# --- Python venv ----------------------------------------------------------
# venv 使用的解释器版本(uv 会按需下载 managed CPython)
VENV_PYTHON="3.12"

# --- Python 包 pins(精确版本)--------------------------------------------
# 包名映射:mcp -> mcp, pydantic -> pydantic, astropy -> astropy,
#          PY_PINT -> pint-pulsar, PY_PSRQPY -> psrqpy, 其余同名
PY_MCP="2.3.0"
PY_PYDANTIC="2.14.1"
PY_ASTROPY="8.0.2"
PY_PINT="1.1.8"
PY_PSRQPY="1.3.3"
PY_MATPLOTLIB="3.11.2"
PY_NUMPY="2.5.4"
# 测试依赖:只约束下限(与仓库 pyproject.toml 的 dev group 一致)
PY_PYTEST=">=8.3"
