# ---------------------------------------------------------------------------
# versions.env — versions / pins / download URLs of the pulsar software stack (single source of truth)
#
# Sourced by scripts/install_pulsar_stack.sh. Change pins here only; never touch install logic.
# Syntax constraint: must be bash-sourceable plain KEY="VALUE" assignments (no commands, no export).
#
# Conventions:
#   *_URL       primary download/clone URL
#   *_MIRROR_*  fallback URL when the primary fails (may be empty = no fallback)
#   *_REF       git pin: a concrete commit / tag / branch
#   PY_*        Python package versions (no package names; name mapping in install_pulsar_stack.sh)
#
# The three *_REF values below are commits that actually installed and verified on 2026-10-24
# (the whole stack compiled and passed the 19 CLI contract probes in this state on
# Deepin 25 / gcc12); they are pinned for reproducibility — switch back to HEAD or another
# commit to track new.
# ---------------------------------------------------------------------------

# --- tempo2 ---------------------------------------------------------------
# bitbucket.org/psrsoft is no longer the authoritative repo; the official mirror lives in the github ipta org
TEMPO2_URL="https://github.com/ipta/tempo2.git"
TEMPO2_MIRROR_URL="https://github.com/mattpitkin/tempo2.git"
TEMPO2_REF="fda6ad4a9753ad7dc5d291406f2f310a9161423f"
# resolved 2026-10-24: commit verified to work (2026-10-12)

# --- psrchive -------------------------------------------------------------
PSRCHIVE_URL="https://gitlab.com/pulsar-astronomy/psrchive.git"
PSRCHIVE_MIRROR_URL="https://github.com/psrchive/psrchive.git"
PSRCHIVE_REF="d4b4e2d9c4bd31a5834f8bc2219bfcb87f70b20e"
# resolved 2026-10-24: commit verified to work (2026-10-19; includes the 2026-05 Convention::* renames)

# --- dspsr ----------------------------------------------------------------
# the authoritative repo is on SourceForge in practice (gitlab.com/pulsar-astronomy/dspsr is an unofficial sync)
DSPSR_URL="https://git.code.sf.net/p/dspsr/code"
DSPSR_MIRROR_URL="https://gitlab.com/pulsar-astronomy/dspsr.git"
DSPSR_REF="3f3d5b437f4840ab8a6a656002dca2cb5f3aa680"
# resolved 2026-10-24: commit verified to work (2026-05-27; needs the psrchive API compat patches)

# --- tempo (classic tempo, optional stage) ---------------------------------
TEMPO_URL="https://git.code.sf.net/p/tempo/tempo"
TEMPO_REF="HEAD"

# --- PRESTO (installed only with --with-presto) ----------------------------
PRESTO_URL="https://github.com/scottransom/presto.git"
PRESTO_TAG="v5.2.0"

# --- psrcat (ATNF catalogue package) ---------------------------------------
# NOTE: ATNF's auto-download URL is dead (404 as of 2026-10); the script no longer tries to
# download it. Fetch the psrcat_pkg tarball manually from the ATNF website (v2.6.1 verified
# to work); the installer searches in the order --psrcat-tarball → $SRC_DIR → ~/Downloads →
# cwd. Build command: `gcc -fcommon -o psrcat *.c -lm` (newer gcc requires -fcommon); no tcsh.
PSRCAT_VERSION="2.6.1"

# --- Build deps (hard deps of psrchive/dspsr, built from source into the prefix) ---
# system apt's libfftw3-dev is double-precision only and libcfitsio-dev is non-reentrant; not enough
FFTW_VERSION="3.2.2"
FFTW_URL="http://www.fftw.org/fftw-3.2.2.tar.gz"
CFITSIO_VERSION="3.49"
CFITSIO_URL="https://heasarc.gsfc.nasa.gov/FTP/software/fitsio/c/cfitsio-3.49.tar.gz"

# --- PGPLOT (optional stage) ----------------------------------------------
# Caltech ftp is dead; the ASTRON GitLab mirror is verified to work. Patches come from the psrchive tree's packages/
PGPLOT_VERSION="5.2"
PGPLOT_URL="https://git.astron.nl/giga/psrmod_snellius/-/raw/main/sources_tar/pgplot5.2.tar.gz"

# --- Python venv ----------------------------------------------------------
# interpreter version used by the venv (uv downloads a managed CPython on demand)
VENV_PYTHON="3.12"

# --- Python package pins (exact versions) ----------------------------------
# name mapping: mcp -> mcp, pydantic -> pydantic, astropy -> astropy,
#          PY_PINT -> pint-pulsar, PY_PSRQPY -> psrqpy, the rest map to the same name
PY_MCP="2.3.0"
PY_PYDANTIC="2.14.1"
PY_ASTROPY="8.0.2"
PY_PINT="1.1.8"
PY_PSRQPY="1.3.3"
PY_MATPLOTLIB="3.11.2"
PY_NUMPY="2.5.4"
# test deps: lower bound only (matches the repo pyproject.toml dev group)
PY_PYTEST=">=8.3"
